sra format
use tabs: true
0-r:Root
	1-o:asset
		2-v:type
			3-s:AnimationClip
		2-o:ptr
			3-v:clipName
				4-s:mixamo.com
			3-v:clipPath
				4-s:Samples/MechanicGirl/Animations/Start Walking.fbx
			3-o:rig
				4-v:id
					5-s:Engine/Rig/Mixamo.rig
			3-a:excludedBones
			3-a:lockedBones
				4-k:item
					5-v:first
						6-s:mixamorig1:Hips
					5-o:second
						6-v:translation
							7-s:Z
			3-a:retargetProfiles
				4-k:i
					5-o:d
						6-o:targetRig
							7-v:id
								8-s:Engine/Rig/FortniteHumanoid.rig
						6-o:algorithm
							7-v:type
								8-s:RetargetReferencePoseDeltaAlgorithm
							7-o:ptr
								8-o:targetHipsOffset
									9-v:z
										10-f:-0.04
						6-o:IKCorrection
							7-v:type
								8-s:RetargetIKCorrection
							7-o:ptr
								8-o:IKLeftHandOffset
									9-v:x
										10-f:-0.05
									9-v:y
										10-f:0.15
									9-v:z
										10-f:-0.15
								8-o:IKRightHandOffset
									9-v:x
										10-f:0.05
									9-v:y
										10-f:0.09
									9-v:z
										10-f:-0.15
								8-v:twoBoneWeight
									9-f:0.5
								8-v:ccdWeight
									9-f:0
			3-o:startTime
				4-v:has
					5-b:true
				4-v:value
					5-f:0.5
